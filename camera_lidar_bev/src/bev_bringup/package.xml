<?xml version="1.0"?>
<package format="3">
  <name>bev_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration for local camera and LiDAR BEV development.</description>
  <maintainer email="maintainer@example.com">BEV project maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>bev_sensor_bridge</exec_depend>
  <exec_depend>bev_visualization</exec_depend>
  <exec_depend>bev_geometry</exec_depend>
  <exec_depend>bev_lidar_detection</exec_depend>
  <exec_depend>bev_path_tracking</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
