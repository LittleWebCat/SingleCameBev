<?xml version="1.0"?>
<package format="3">
  <name>bev_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration for local camera and LiDAR BEV development.</description>
  <maintainer email="maintainer@example.com">BEV project maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>bev_sensor_bridge</exec_depend>
  <exec_depend>bev_visualization</exec_depend>
  <exec_depend>bev_geometry</exec_depend>
  <exec_depend>bev_lidar_detection</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
