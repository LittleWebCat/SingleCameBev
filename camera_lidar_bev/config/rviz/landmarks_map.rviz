# Map view (fixed frame enu): saved map, mapped route, kept stop signs / traffic lights.
# Needs only tools/localization_rviz_bridge.py (no sensors); with live localization the driven path
# also appears. Drag to rotate, scroll to zoom, shift+drag to pan.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 78
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5
  Tree Height: 500
- Class: rviz_common/Views
  Name: Views
  Expanded:
  - /Current View1
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 1
    Autocompute Intensity Bounds: false
    Autocompute Value Bounds:
      Max Value: 8.0
      Min Value: -6.0
      Value: false
    Axis: Z
    Channel Name: height
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: Intensity
    Decay Time: 0.0
    Enabled: true
    Invert Rainbow: false
    Max Color: 230; 230; 230
    Max Intensity: 8
    Min Color: 40; 60; 90
    Min Intensity: 0
    Name: Saved map (dark ground to white 8 m up)
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 2
    Size (m): 0.003
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      Filter size: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /camera_lidar_bev/map/points
    Use Fixed Frame: true
    Use rainbow: false
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 25; 255; 0
    Enabled: true
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Line Style: Billboards
    Line Width: 2.0
    Name: Mapped route (green, just above ground)
    Offset:
      X: 0
      Y: 0
      Z: -1.2
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /camera_lidar_bev/route/reference
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 0; 229; 255
    Enabled: true
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Line Style: Billboards
    Line Width: 1.2
    Name: Driven path (cyan, just above ground, while localized)
    Offset:
      X: 0
      Y: 0
      Z: -1.0
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /camera_lidar_bev/route/driven
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: 'Kept stop signs (red), traffic lights (yellow), estimated stop lines (white), 4x size'
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /camera_lidar_bev/landmarks/kept_markers_map
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: enu
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 430.0
      Focal Point:
        X: 23.0
        Y: 112.0
        Z: -3.7
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: 'Orbit: whole route, north up'
      Near Clip Distance: 0.01
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: -1.5708
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 950
  Hide Left Dock: true
  Hide Right Dock: true
  Views:
    collapsed: false
  Width: 1440
  X: 40
  Y: 40
