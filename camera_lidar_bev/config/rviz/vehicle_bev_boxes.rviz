# Vehicle footprints and labeled object points: approximately 60 m forward at the default window size.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 78
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Camera object points: magenta person, orange vehicle1
    - /Vehicle BEV footprints and labels1
    Splitter Ratio: 0.5
  Tree Height: 500
- Class: rviz_common/Views
  Name: Views
  Expanded:
  - /Current View1
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0.0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 255
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Ground / obstacles / unknown
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.003
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      Filter size: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /camera_lidar_bev/ground_bev_points
    Use Fixed Frame: true
    Use rainbow: false
    Value: false
  - Class: rviz_default_plugins/Map
    Name: Observed occupancy (toggle)
    Enabled: false
    Value: false
    Alpha: 0.5
    Color Scheme: map
    Draw Behind: true
    Topic:
      Value: /camera_lidar_bev/occupancy
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Use Timestamp: false
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: RGB8
    Decay Time: 0.0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 255
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: 'Camera object points: magenta person, orange vehicle'
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 4
    Size (m): 0.003
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      Filter size: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /camera_lidar_bev/semantic_points
    Use Fixed Frame: true
    Use rainbow: false
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: 'Camera objects: observed 3D extents and labels'
    Enabled: false
    Value: false
    Namespaces: {}
    Topic:
      Value: /camera_lidar_bev/object_markers
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: Vehicle BEV footprints and labels
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /camera_lidar_bev/vehicle_bev_markers
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: os_sensor
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: -1.5707963267948966
      Scale: 14.0
      X: 30.0
      Y: 0.0
      Name: 'Vehicle footprints: approximately 0–60 m ahead'
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz)
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 950
  Hide Left Dock: true
  Hide Right Dock: true
  Views:
    collapsed: false
  Width: 1440
  X: 40
  Y: 40
