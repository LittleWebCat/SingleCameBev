# 3D planning view: raw scan (subdued), detected vehicles / pedestrians / cyclists as 3D boxes, kept stop signs
# and stop lines, mapped route and the speed-coloured planned trajectory. No traffic lights.
# Needs tools/bev_scene_markers.py (scene) and tools/localization_rviz_bridge.py (TF enu -> os_sensor).
# Drag to rotate, scroll to zoom, shift+drag to pan.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 0
  Property Tree Widget:
    Expanded: ~
    Splitter Ratio: 0.62
  Tree Height: 200
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.35
    Cell Size: 5
    Class: rviz_default_plugins/Grid
    Color: 90; 100; 120
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid (5 m)
    Normal Cell Count: 0
    Offset:
      X: 10
      Y: 0
      Z: -1.85
    Plane: XY
    Plane Cell Count: 16
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 0.75
    Autocompute Intensity Bounds: false
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: z
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: Intensity
    Decay Time: 0.0
    Enabled: true
    Invert Rainbow: false
    Max Color: 170; 180; 195
    Max Intensity: 2.5
    Min Color: 50; 60; 78
    Min Intensity: -1.9
    Name: LiDAR /points
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 2
    Size (m): 0.003
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      Filter size: 1
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /points
    Use Fixed Frame: true
    Use rainbow: false
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Simulation (traffic lights, true road users)
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /camera_lidar_bev/sim/markers
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: HD map (lanes, kerbs, crosswalks, stop lines)
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /camera_lidar_bev/hdmap/markers
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: Route + stop signs
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /camera_lidar_bev/bev_scene/static_markers
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: Objects + plan
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /camera_lidar_bev/bev_scene/markers
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: 'Predicted paths (vehicles 5 s, pedestrians 4 s)'
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /camera_lidar_bev/prediction/markers
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: Own vehicle outline
    Enabled: true
    Value: true
    Namespaces:
      ego_vehicle: false
      ego_vehicle_3d: true
    Topic:
      Value: /camera_lidar_bev/ego_vehicle_marker
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: Planner markers (toggle)
    Enabled: false
    Value: false
    Namespaces: {}
    Topic:
      Value: /camera_lidar_bev/planner/markers
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: 'Lanes: LiDAR (orange lines, red road edge, green centre)'
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /camera_lidar_bev/lanes/lidar_markers
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/MarkerArray
    Name: 'Lanes: cameras narrow + wide fused (blue lines, violet road edge, cyan centre)'
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /camera_lidar_bev/lanes/camera_narrow_wide_markers
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
  - Alpha: 0.6
    Autocompute Intensity Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Name: 'Segmentation front_wide (road green, lane blue, on the road plane)'
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 3
    Size (m): 0.01
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera_lidar_bev/lanes/camera_front_wide/segmentation
    Use Fixed Frame: true
    Value: true
  - Alpha: 0.6
    Autocompute Intensity Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: RGB8
    Decay Time: 0
    Enabled: true
    Name: 'Segmentation front_narrow (road green, lane blue, on the road plane)'
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 3
    Size (m): 0.01
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera_lidar_bev/lanes/camera_front_narrow/segmentation
    Use Fixed Frame: true
    Value: true
  Enabled: true
  Global Options:
    Background Color: 16; 18; 24
    Fixed Frame: os_sensor
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 34.0
      Focal Point:
        X: 12.0
        Y: 0.0
        Z: -1.8
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: 'Orbit: behind and above the vehicle'
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.1416
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 950
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1440
  X: 40
  Y: 40
